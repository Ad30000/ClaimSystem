@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-tachometer-alt me-2"></i>Lecturer Dashboard</h2>
            <a href="/Claim/Create" class="btn btn-primary btn-lg">
                <i class="badge bg-success fs-5 px-3 py-2"></i>Submit New Claim
            </a>
        </div>

        <div class="alert alert-success">
            <i class="fas fa-user me-2"></i>Welcome, Dr. Sarah Johnson
        </div>

        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-history me-2"></i>Recent Claims</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Claim ID</th>
                                <th>Date Submitted</th>
                                <th>Hours Worked</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>CLM-001</td>
                                <td>2025-01-15</td>
                                <td>40</td>
                                <td>R20,000</td>
                                <td><span class="badge bg-success">Approved</span></td>
                                <td><a href="/Claim/Details" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                            <tr>
                                <td>CLM-002</td>
                                <td>2025-02-20</td>
                                <td>35</td>
                                <td>R19,250</td>
                                <td><span class="badge bg-warning">Pending</span></td>
                                <td><a href="/Claim/Details" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                            <tr>
                                <td>CLM-003</td>
                                <td>2025-03-10</td>
                                <td>45</td>
                                <td>R27,000</td>
                                <td><span class="badge bg-danger">Rejected</span></td>
                                <td><a href="/Claim/Details" class="btn btn-sm btn-outline-primary">View</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
