

@model IEnumerable<ClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-tachometer-alt me-2"></i>Lecturer Dashboard</h2>
            <a href="/Claim/Create" class="btn btn-primary btn-lg">
                <i class="fas fa-plus me-2"></i>Submit New Claim
            </a>
        </div>

        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserEmail")))
        {
            <div class="alert alert-info">
                <i class="fas fa-user me-2"></i>Welcome, @Context.Session.GetString("UserEmail")
                <span class="badge bg-secondary ms-2">@Context.Session.GetString("UserRole")</span>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-history me-2"></i>Your Claims</h5>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>No claims found.
                        <a href="/Claim/Create" class="alert-link">Submit your first claim</a>.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Claim ID</th>
                                    <th>Date Submitted</th>
                                    <th>Month</th>
                                    <th>Hours Worked</th>
                                    <th>Total Amount</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model)
                                {
                                    <tr>
                                        <td>@claim.ClaimNumber</td>
                                        <td>@claim.DateSubmitted.ToString("yyyy-MM-dd")</td>
                                        <td>@claim.MonthClaim</td>
                                        <td>@claim.HoursWorked</td>
                                        <td>R @claim.TotalAmount?.ToString("F2")</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(claim.Status)">
                                                @claim.Status
                                            </span>
                                        </td>
                                        <td>
                                            <a href="/Claim/Details/@claim.ClaimId" class="btn btn-sm btn-outline-primary">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "approved" => "bg-success",
            "rejected" => "bg-danger",
            "pending" => "bg-warning",
            _ => "bg-secondary"
        };
    }
}