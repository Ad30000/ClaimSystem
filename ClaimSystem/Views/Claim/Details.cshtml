@{
    ViewData["Title"] = "Claim Details";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h4 class="mb-0"><i class="fas fa-file-alt me-2"></i>Claim Details - CLM-002</h4>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center">
                            <strong class="me-3">Status:</strong>
                            <span class="badge bg-warning fs-6">Pending Review</span>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <small class="text-muted">Submitted: February 20, 2025</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Claim Information</h6>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm">
                                    <tr>
                                        <th>Hours Worked:</th>
                                        <td>35</td>
                                    </tr>
                                    <tr>
                                        <th>Hourly Rate:</th>
                                        <td>R550.00</td>
                                    </tr>
                                    <tr>
                                        <th>Total Amount:</th>
                                        <td class="fw-bold">R19,250.00</td>
                                    </tr>
                                    <tr>
                                        <th>Claim Period:</th>
                                        <td>February 1-28, 2025</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Supporting Documents</h6>
                            </div>
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-file-pdf text-danger me-2"></i>
                                    <span>timesheet_feb2025.pdf</span>
                                    <a href="#" class="btn btn-sm btn-outline-primary ms-3">Download</a>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-file-excel text-success me-2"></i>
                                    <span>expense_report.xlsx</span>
                                    <a href="#" class="btn btn-sm btn-outline-primary ms-3">Download</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Description</h6>
                    </div>
                    <div class="card-body">
                        <p>Monthly lecture hours for Advanced Programming course, including student consultations and assignment marking.</p>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a href="/Home/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>