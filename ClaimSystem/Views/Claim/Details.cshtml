@model ClaimSystem.Models.Claim
@{
    ViewData["Title"] = "Claim Details";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h4 class="mb-0"><i class="fas fa-file-alt me-2"></i>Claim Details - @Model.ClaimNumber</h4>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center">
                            <strong class="me-3">Status:</strong>
                            <span class="badge @GetStatusBadgeClass(Model.Status) fs-6">@Model.Status</span>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end">
                        <small class="text-muted">Submitted: @Model.DateSubmitted.ToString("MMMM dd, yyyy")</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Claim Information</h6>
                            </div>
                            <div class="card-body">
                                <table class="table table-sm">
                                    <tr>
                                        <th>Hours Worked:</th>
                                        <td>@Model.HoursWorked</td>
                                    </tr>
                                    <tr>
                                        <th>Hourly Rate:</th>
                                        <td>R @Model.AmountPerHour.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <th>Total Amount:</th>
                                        <td class="fw-bold">R @Model.TotalAmount?.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <th>Claim Month:</th>
                                        <td>@Model.MonthClaim</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Supporting Documents</h6>
                            </div>
                            <div class="card-body">
                                @if (Model.SupportingDocuments?.Any() == true)
                                {
                                    foreach (var doc in Model.SupportingDocuments)
                                    {
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fas fa-file @* @GetFileIconClass *@(doc.FileName) me-2"></i>
                                            <span>@doc.FileName</span>
                                            <a href="#" class="btn btn-sm btn-outline-primary ms-3">Download</a>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">No supporting documents uploaded.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
                {
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">Additional Notes</h6>
                        </div>
                        <div class="card-body">
                            <p>@Model.AdditionalNotes</p>
                        </div>
                    </div>
                }

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a href="/Home/Dashboard" class="btn btn-secondary">Back to Dashboard</a>

                    @if (TempData["UserRole"]?.ToString() == "coordinator" || TempData["UserRole"]?.ToString() == "manager")
                    {
                        <form asp-controller="Review" asp-action="Approve" method="post" class="ms-2">
                            <input type="hidden" name="id" value="@Model.ClaimId" />
                            <button type="submit" class="btn btn-success">Approve</button>
                        </form>
                        <form asp-controller="Review" asp-action="Reject" method="post" class="ms-2">
                            <input type="hidden" name="id" value="@Model.ClaimId" />
                            <button type="submit" class="btn btn-danger">Reject</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "approved" => "bg-success",
            "rejected" => "bg-danger",
            "pending" => "bg-warning",
            _ => "bg-secondary"
        };
    }

