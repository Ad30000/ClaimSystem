@model ClaimSystem.Models.Claim
@{
    ViewData["Title"] = "Approval History";
    Layout = "_Layout";
    var userRole = ViewBag.UserRole as string;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow">
            <div class="card-header bg-light">
                <h4 class="mb-0">
                    <i class="fas fa-history me-2"></i>Approval History - @Model.ClaimNumber
                </h4>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <strong>Lecturer:</strong> @Model.Lecturer?.Name<br />
                        <strong>Claim Month:</strong> @Model.MonthClaim<br />
                        <strong>Total Amount:</strong> R @Model.TotalAmount?.ToString("F2")
                    </div>
                    <div class="col-md-6">
                        <strong>Current Status:</strong>
                        <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span><br />
                        <strong>Submitted:</strong> @Model.DateSubmitted.ToString("MMMM dd, yyyy")<br />
                        <strong>Last Updated:</strong> @Model.LastUpdatedDate.ToString("MMMM dd, yyyy")
                    </div>
                </div>

                <h5 class="mb-3"><i class="fas fa-list-alt me-2"></i>Approval Timeline</h5>

                @if (Model.ClaimApprovals?.Any() == true)
                {
                    <div class="timeline">
                        @foreach (var approval in Model.ClaimApprovals.OrderBy(a => a.ApprovalDate))
                        {
                            <div class="timeline-item @(approval.Action == "Approve" ? "timeline-success" : approval.Action == "Reject" ? "timeline-danger" : "timeline-warning")">
                                <div class="timeline-marker"></div>
                                <div class="timeline-content">
                                    <div class="d-flex justify-content-between">
                                        <strong>@approval.Role</strong>
                                        <small class="text-muted">@approval.ApprovalDate.ToString("MMM dd, yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-1">
                                        <span class="badge @GetActionBadgeClass(approval.Action)">@approval.Action</span>
                                        - @approval.Status
                                    </p>
                                    @if (!string.IsNullOrEmpty(approval.Comments))
                                    {
                                        <p class="text-muted small mb-0">@approval.Comments</p>
                                    }
                                    <small class="text-muted">By: @approval.Approver?.Username</small>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>No approval history found for this claim.
                    </div>
                }

                <div class="mt-4">
                    <a href="/Review/Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Review
                    </a>
                    <a href="/Claim/Details/@Model.ClaimId" class="btn btn-outline-primary ms-2">
                        <i class="fas fa-file-alt me-2"></i>View Claim Details
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 20px;
        padding-left: 20px;
    }

    .timeline-marker {
        position: absolute;
        left: -30px;
        top: 0;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #6c757d;
    }

    .timeline-success .timeline-marker { background: #198754; }
    .timeline-danger .timeline-marker { background: #dc3545; }
    .timeline-warning .timeline-marker { background: #ffc107; }

    .timeline-content {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 5px;
        border-left: 3px solid #6c757d;
    }

    .timeline-success .timeline-content { border-left-color: #198754; }
    .timeline-danger .timeline-content { border-left-color: #dc3545; }
    .timeline-warning .timeline-content { border-left-color: #ffc107; }
</style>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "approved" => "bg-success",
            "rejected" => "bg-danger",
            "pending" => "bg-warning",
            "coordinator approved" => "bg-info",
            "revision requested" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    public string GetActionBadgeClass(string action)
    {
        return action?.ToLower() switch
        {
            "approve" => "bg-success",
            "reject" => "bg-danger",
            "request revision" => "bg-warning",
            _ => "bg-secondary"
        };
    }
}