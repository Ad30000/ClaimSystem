@{
    ViewData["Title"] = "Review Claims";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-check-circle me-2"></i>Claims Review Dashboard</h2>
            <span class="badge bg-success fs-5 px-3 py-2">Coordinator View</span>
        </div>

        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            This is the coordinator review interface. Approve/Reject buttons are for demonstration only.
        </div>

        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-list me-2"></i>Pending Claims for Review</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Claim ID</th>
                                <th>Lecturer</th>
                                <th>Date Submitted</th>
                                <th>Hours</th>
                                <th>Rate (R)</th>
                                <th>Total (R)</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>CLM-004</td>
                                <td>Dr. Sarah Johnson</td>
                                <td>2025-03-15</td>
                                <td>40</td>
                                <td>600</td>
                                <td>24,000</td>
                                <td><span class="badge bg-warning">Pending</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-success">Approve</button>
                                        <button class="btn btn-danger">Reject</button>
                                        <a href="/Claim/Details" class="btn btn-outline-primary">Details</a>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>CLM-005</td>
                                <td>Prof. Michael Chen</td>
                                <td>2025-03-16</td>
                                <td>38</td>
                                <td>650</td>
                                <td>24,700</td>
                                <td><span class="badge bg-warning">Pending</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-success">Approve</button>
                                        <button class="btn btn-danger">Reject</button>
                                        <a href="/Claim/Details" class="btn btn-outline-primary">Details</a>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>CLM-006</td>
                                <td>Dr. Amina Dlamini</td>
                                <td>2025-03-17</td>
                                <td>42</td>
                                <td>580</td>
                                <td>24,360</td>
                                <td><span class="badge bg-warning">Pending</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-success">Approve</button>
                                        <button class="btn btn-danger">Reject</button>
                                        <a href="/Claim/Details" class="btn btn-outline-primary">Details</a>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
