@model IEnumerable<ClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "Review Claims";
    Layout = "_Layout";  // This references your separate layout file
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-check-circle me-2"></i>Claims Review Dashboard</h2>
            <span class="badge bg-info fs-6 px-3 py-2">@(TempData["UserRole"]?.ToString() ?? "Reviewer") View</span>
        </div>

        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="fas fa-list me-2"></i>Pending Claims for Review</h5>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>No pending claims found for review.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Claim #</th>
                                    <th>Lecturer</th>
                                    <th>Date Submitted</th>
                                    <th>Month</th>
                                    <th>Hours</th>
                                    <th>Rate (R)</th>
                                    <th>Total (R)</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model)
                                {
                                    <tr>
                                        <td>@claim.ClaimNumber</td>
                                        <td>@(claim.Lecturer?.Name ?? "N/A")</td>
                                        <td>@claim.DateSubmitted.ToString("yyyy-MM-dd")</td>
                                        <td>@claim.MonthClaim</td>
                                        <td>@claim.HoursWorked</td>
                                        <td>@claim.AmountPerHour.ToString("F2")</td>
                                        <td>@claim.TotalAmount?.ToString("F2")</td>
                                        <td>
                                            <span class="badge bg-warning">@claim.Status</span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="/Claim/Details/@claim.ClaimId" class="btn btn-outline-primary">Review</a>
                                                <form asp-action="Approve" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@claim.ClaimId" />
                                                    <button type="submit" class="btn btn-success">Approve</button>
                                                </form>
                                                <form asp-action="Reject" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@claim.ClaimId" />
                                                    <button type="submit" class="btn btn-danger">Reject</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

 *@

@using ClaimSystem.DB
@inject ClaimDatabaseContext _context

@model IEnumerable<ClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "Review Claims";
    Layout = "_Layout";
    var userRole = ViewBag.UserRole as string;
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fas fa-check-circle me-2"></i>Claims Review Dashboard</h2>
            <span class="badge bg-info fs-6 px-3 py-2">@userRole View</span>
        </div>

        @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card">
            <div class="card-header bg-light">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>
                    @if (userRole == "Coordinator")
                    {
                        <text>Pending Claims for Initial Review</text>
                    }
                    else
                    {
                        <text>Claims Awaiting Final Approval</text>
                    }
                </h5>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        @if (userRole == "Coordinator")
                        {
                            <text>No pending claims found for initial review.</text>
                        }
                        else
                        {
                            <text>No claims awaiting final approval.</text>
                        }
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Claim #</th>
                                    <th>Lecturer</th>
                                    <th>Date Submitted</th>
                                    <th>Month</th>
                                    <th>Hours</th>
                                    <th>Rate (R)</th>
                                    <th>Total (R)</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var claim in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@claim.ClaimNumber</strong>
                                            <br />
                                            <small class="text-muted">ID: @claim.ClaimId</small>
                                        </td>
                                        <td>@(claim.Lecturer?.Name ?? "N/A")</td>
                                        <td>@claim.DateSubmitted.ToString("yyyy-MM-dd")</td>
                                        <td>@claim.MonthClaim</td>
                                        <td>@claim.HoursWorked.ToString("F1")</td>
                                        <td>@claim.AmountPerHour.ToString("F2")</td>
                                        <td class="fw-bold">@claim.TotalAmount?.ToString("F2")</td>
                                        <td>
                                            <span class="badge @GetStatusBadgeClass(claim.Status)">@claim.Status</span>
                                        </td>
                                        <td>
                                            <div class="btn-group-vertical btn-group-sm">
                                                <a href="/Claim/Details/@claim.ClaimId" class="btn btn-outline-primary mb-1">
                                                    <i class="fas fa-eye me-1"></i>Review Details
                                                </a>
                                                <a href="/Review/ApprovalHistory/@claim.ClaimId" class="btn btn-outline-info mb-1">
                                                    <i class="fas fa-history me-1"></i>View History
                                                </a>
                                                <div class="btn-group btn-group-sm">
                                                    <form asp-action="Approve" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@claim.ClaimId" />
                                                        <button type="submit" class="btn btn-success">
                                                            <i class="fas fa-check me-1"></i>Approve
                                                        </button>
                                                    </form>
                                                    <form asp-action="Reject" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@claim.ClaimId" />
                                                        <button type="submit" class="btn btn-danger"
                                                                onclick="return confirm('Are you sure you want to reject this claim?')">
                                                            <i class="fas fa-times me-1"></i>Reject
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (userRole == "Manager")
        {
            <div class="card mt-4">
                <div class="card-header bg-warning">
                    <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Approval Statistics</h5>
                </div>
                <div class="card-body">
                    @{
                        var totalClaims = _context.Claims.Count();
                        var approvedClaims = _context.Claims.Count(c => c.Status == "Approved");
                        var pendingClaims = _context.Claims.Count(c => c.Status == "Pending");
                        var coordinatorApproved = _context.Claims.Count(c => c.Status == "Coordinator Approved");
                    }
                    <div class="row text-center">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <h4>@totalClaims</h4>
                                    <p>Total Claims</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <h4>@approvedClaims</h4>
                                    <p>Fully Approved</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <h4>@coordinatorApproved</h4>
                                    <p>Coordinator Approved</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <h4>@pendingClaims</h4>
                                    <p>Pending Review</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "approved" => "bg-success",
            "rejected" => "bg-danger",
            "pending" => "bg-warning",
            "coordinator approved" => "bg-info",
            "revision requested" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}