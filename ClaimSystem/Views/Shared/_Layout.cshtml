                                            <a class="dropdown-item" asp-area="" asp-controller="Hr" asp-action="Dashboard">
                                                <i class="fas fa-tachometer-alt me-2"></i>HR Dashboard
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Hr" asp-action="ManageUsers">
