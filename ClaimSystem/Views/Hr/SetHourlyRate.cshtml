@{
    ViewData["Title"] = "Set Hourly Rate";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-warning text-white">
                <h4><i class="fas fa-money-bill-wave me-2"></i>Set Default Hourly Rate</h4>
            </div>
            <div class="card-body">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    This hourly rate will be automatically applied to all new claims submitted by lecturers.
                    Existing claims will not be affected.
                </div>

                <form asp-action="SetHourlyRate" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="hourlyRate" class="form-label">Default Hourly Rate (R) *</label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input type="number" class="form-control" id="hourlyRate" name="hourlyRate"
                                   min="0" step="0.01" placeholder="0.00" required>
                        </div>
                        <small class="form-text text-muted">
                            Enter the default hourly rate in South African Rands
                        </small>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">Current Rate Information</h6>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Current Default Rate:</strong> R 0.00</p>
                            <p class="mb-1"><strong>Last Updated:</strong> Never</p>
                            <p class="mb-0"><strong>Affected Claims:</strong> 0 claims will use this rate</p>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="@Url.Action("Dashboard")" class="btn btn-secondary me-md-2">
                            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-2"></i>Save Hourly Rate
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>