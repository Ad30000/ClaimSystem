@model IEnumerable<ClaimSystem.Models.Lecturer>
@{
    ViewData["Title"] = "Manage Lecturers";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-users me-2"></i>Manage Lecturers</h2>
                <a href="@Url.Action("AddLecturer")" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Add New Lecturer
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No lecturers found.
                    <a href="@Url.Action("AddLecturer")" class="alert-link">Add the first lecturer</a>.
                </div>
            }
            else
            {
                <div class="card shadow">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Lecturer List</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Department</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Total Claims</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lecturer in Model)
                                    {
                                        <tr>
                                            <td>@lecturer.LecturerId</td>
                                            <td>
                                                <strong>@lecturer.Name</strong>
                                            </td>
                                            <td>@lecturer.Department</td>
                                            <td>@lecturer.User?.Email</td>
                                            <td>@(lecturer.PhoneNumber ?? "N/A")</td>
                                            <td>
                                                <span class="badge bg-info">@lecturer.Claims.Count</span>
                                            </td>
                                            <td>
                                                <span class="badge @(lecturer.User?.IsActive == true ? "bg-success" : "bg-danger")">
                                                    @(lecturer.User?.IsActive == true ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="@Url.Action("EditLecturer", new { id = lecturer.LecturerId })"
                                                       class="btn btn-outline-primary" title="Edit Lecturer">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a href="@Url.Action("LecturerDetails", new { id = lecturer.LecturerId })"
                                                       class="btn btn-outline-info" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <form asp-action="ToggleLecturerStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@lecturer.LecturerId" />
                                                        <button type="submit" class="btn btn-outline-warning"
                                                                title="@(lecturer.User?.IsActive == true ? "Deactivate" : "Activate")"
                                                                onclick="return confirm('Are you sure you want to @(lecturer.User?.IsActive == true ? "deactivate" : "activate") this lecturer?')">
                                                            <i class="fas @(lecturer.User?.IsActive == true ? "fa-user-slash" : "fa-user-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>