@model ClaimSystem.Models.DashboardViewModel
@{
    ViewData["Title"] = "HR Dashboard";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-12">
        <h2><i class="fas fa-tachometer-alt me-2"></i>HR Dashboard</h2>

        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-2">
                <div class="card text-white bg-primary">
                    <div class="card-body">
                        <h4 class="card-title">@Model.Statistics.TotalClaims</h4>
                        <p class="card-text">Total Claims</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white bg-warning">
                    <div class="card-body">
                        <h4 class="card-title">@Model.Statistics.PendingClaims</h4>
                        <p class="card-text">Pending</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <h4 class="card-title">@Model.Statistics.ApprovedClaims</h4>
                        <p class="card-text">Approved</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white bg-info">
                    <div class="card-body">
                        <h4 class="card-title">@Model.Statistics.CoordinatorApproved</h4>
                        <p class="card-text">Coordinator Approved</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white bg-danger">
                    <div class="card-body">
                        <h4 class="card-title">@Model.Statistics.RejectedClaims</h4>
                        <p class="card-text">Rejected</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="card text-white bg-secondary">
                    <div class="card-body">
                        <h4 class="card-title">@Model.Statistics.TotalLecturers</h4>
                        <p class="card-text">Lecturers</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Activity Section -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Recent Activity</h5>
                    </div>
                    <div class="card-body">
                        @if (!Model.RecentClaims.Any())
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>No recent claims found.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Claim ID</th>
                                            <th>Lecturer</th>
                                            <th>Date Submitted</th>
                                            <th>Month</th>
                                            <th>Hours</th>
                                            <th>Total Amount</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var claim in Model.RecentClaims)
                                        {
                                            <tr>
                                                <td>@claim.ClaimNumber</td>
                                                <td>@claim.Lecturer?.Name</td>
                                                <td>@claim.DateSubmitted.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@claim.MonthClaim</td>
                                                <td>@claim.HoursWorked</td>
                                                <td>R @claim.TotalAmount?.ToString("F2")</td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(claim.Status)">
                                                        @claim.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    <a href="/Claim/Details/@claim.ClaimId" class="btn btn-sm btn-outline-primary">View</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <a href="/Hr/ManageLecturers" class="btn btn-outline-primary btn-lg w-100">
                            <i class="fas fa-users me-2"></i>Manage Lecturers
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <a href="/Hr/GenerateReports" class="btn btn-outline-success btn-lg w-100">
                            <i class="fas fa-chart-bar me-2"></i>Generate Reports
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <a href="/Hr/SetHourlyRate" class="btn btn-outline-warning btn-lg w-100">
                            <i class="fas fa-money-bill-wave me-2"></i>Set Hourly Rate
                        </a>
                    </div>
                </div>
            </div>
            @* <div class="col-md-3">
                <div class="card">
                    <div class="card-body text-center">
                        <a href="/Claim/Index" class="btn btn-outline-info btn-lg w-100">
                            <i class="fas fa-list me-2"></i>View All Claims
                        </a>
                    </div>
                </div>
            </div> *@
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "approved" => "bg-success",
            "rejected" => "bg-danger",
            "pending" => "bg-warning",
            "coordinator approved" => "bg-info",
            _ => "bg-secondary"
        };
    }
}