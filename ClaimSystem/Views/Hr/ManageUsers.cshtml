

@model IEnumerable<ClaimSystem.Models.UserManagementViewModel>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-users-cog me-2"></i>Manage Users</h2>
                <a href="@Url.Action("AddUser")" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Add New User
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No users found.
                    <a href="@Url.Action("AddUser")" class="alert-link">Add the first user</a>.
                </div>
            }
            else
            {
                <div class="card shadow">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-list me-2"></i>All System Users</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Department</th>
                                        <th>Status</th>
                                        <th width="200">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@user.Name</strong>
                                            </td>
                                            <td>@user.Email</td>
                                            <td>
                                                <span class="badge @GetRoleBadgeClass(user.Role)">@user.Role</span>
                                            </td>
                                            <td>@user.Department</td>
                                            <td>
                                                <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                                    @(user.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <!-- Edit Button -->
                                                    <a href="@Url.Action("EditUser", new { id = user.UserId })"
                                                       class="btn btn-outline-primary" title="Edit User">
                                                        <i class="fas fa-edit"></i>
                                                    </a>

                                                    <!-- View Details Button -->
                                                    <a href="@Url.Action("UserDetails", new { id = user.UserId })"
                                                       class="btn btn-outline-info" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>

                                                    <!-- Activate/Deactivate Button -->
                                                    <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                                        <input type="hidden" name="id" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-outline-warning"
                                                                title="@(user.IsActive ? "Deactivate" : "Activate")"
                                                                onclick="return confirm('Are you sure you want to @(user.IsActive ? "deactivate" : "activate") this user?')">
                                                            <i class="fas @(user.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    public string GetRoleBadgeClass(string role)
    {
        return role?.ToLower() switch
        {
            "hr" => "bg-danger",
            "manager" => "bg-warning",
            "coordinator" => "bg-info",
            "lecturer" => "bg-primary",
            _ => "bg-secondary"
        };
    }
}
